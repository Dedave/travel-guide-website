# ── Automatic email delivery (Resend) ───────────────────────────────
# Sign up free at https://resend.com (3,000 emails/month free tier),
# create an API key, and verify your sending domain.

# Your Resend API key (starts with "re_")
RESEND_API_KEY=

# Verified sender address. Must be on a domain you've verified in Resend.
# Example: "Wanderlust Travel Guides <hello@wanderlusttravelguides.com>"
EMAIL_FROM=

# ── Optional ─────────────────────────────────────────────────────────
# Public URL to the free lead-magnet PDF. If unset, the welcome email
# links to the Italy guide page instead.
LEAD_MAGNET_URL=

# Canonical site URL (used in email links/footer).
SITE_URL=https://www.wanderlusttravelguides.com
