# ── Automatic email delivery (Resend) ───────────────────────────────
# Sign up free at https://resend.com (3,000 emails/month free tier),
# create an API key, and verify your sending domain.

# Your Resend API key (starts with "re_")
RESEND_API_KEY=

# Verified sender address. Must be on a domain you've verified in Resend.
# Example: "Wanderlust Travel Guides <hello@wanderlusttravelguides.com>"
EMAIL_FROM=

# ── Optional ─────────────────────────────────────────────────────────
# Public URL to the free lead-magnet PDF. If unset, it defaults to the PDF
# that ships with the site at /downloads/25-hidden-places-in-italy.pdf.
# Only set this if you host the PDF elsewhere (e.g. a CDN).
LEAD_MAGNET_URL=

# Canonical site URL (used in email links/footer).
SITE_URL=https://www.wanderlusttravelguides.com

# If your sending domain isn't verified in Resend yet, the app automatically
# falls back to Resend's sandbox sender (onboarding@resend.dev) so delivery
# still works — but the sandbox can ONLY reach your own Resend account email.
# Once your domain is verified, the branded sender is used and this fallback
# is never triggered. Set to "false" to disable the fallback entirely.
EMAIL_FALLBACK_SANDBOX=true
